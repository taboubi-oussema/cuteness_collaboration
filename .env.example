# Copy this file to ".env" (same folder) and fill in REAL values.
# ".env" is git-ignored. Never commit real secrets.

# --- Required ---
# openssl rand -base64 48
JWT_SECRET=
MAIL_USERNAME=
# Gmail "App password" (Google Account > Security > App passwords)
MAIL_PASSWORD=
GEMINI_API_KEY=
NAVEX_TOKEN_ETAT=

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/cuteness_db
DB_USERNAME=cuteness_app
DB_PASSWORD=

# --- First admin account (only used when no ADMIN exists, min 12 chars) ---
ADMIN_EMAIL=admin@cuteness.tn
ADMIN_INITIAL_PASSWORD=

# --- Web / production ---
FRONTEND_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=
CORS_DEV_ORIGINS=true
TRUST_PROXY_HEADERS=false
JPA_DDL_AUTO=update
SHOW_SQL=false
